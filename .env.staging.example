# HeyMode Customer OS — STAGING environment template (P8-03). Copy to .env on the staging VPS and fill in.
# No secrets are stored here. Staging uses its OWN database, its OWN domain, its OWN keys — never production's.

APP_NAME="HeyMode Customer OS (STAGING)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.crm.example.com
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# A SEPARATE database (and role) from production. Never point staging at the production database.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=heymode_staging
DB_USERNAME=heymode_staging
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Use a DIFFERENT prefix/DB number than production if both ever share a Redis.
REDIS_DB=1
REDIS_PREFIX=heymode-staging-

# ---- WooCommerce: READ-ONLY by construction (the app has no write path, D13). If you point staging at the live store, it only READS.
WOO_BASE_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
# Webhooks are OFF in staging by default. To test them, set true AND register a separate Woo webhook with a NEW secret here.
WOO_WEBHOOK_ENABLED=false
WOO_WEBHOOK_SECRET=
WOO_WEBHOOK_ALLOWED_IPS=
TRUSTED_PROXIES=

# ---- AI: off. Even AI_ENABLED=true does nothing in staging unless AI_ALLOW_IN_STAGING=true; if you turn it on, keep the budget tiny.
AI_ENABLED=false
AI_ALLOW_IN_STAGING=false
AI_PROVIDER=gemini
AI_MODEL=
GEMINI_API_KEY=
AI_BUDGET_MONTHLY_USD=1

DB_AI_READONLY_HOST=127.0.0.1
DB_AI_READONLY_PORT=5432
DB_AI_READONLY_DATABASE=heymode_staging
DB_AI_READONLY_USERNAME=hm_ai_readonly
DB_AI_READONLY_PASSWORD=

# ---- Mail: nothing leaves staging.
MAIL_MAILER=log

# ---- Security (same as production)
SECURITY_ENFORCE_2FA=true

# ---- Backups: off in staging (deploy with --skip-backup).
BACKUP_ENABLED=false
BACKUP_DISK=backup_local

VITE_APP_NAME="${APP_NAME}"
