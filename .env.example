APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=heymode
DB_USERNAME=heymode
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# WooCommerce read-only API (Phase 1 never writes). HTTPS store root, no trailing path.
WOO_BASE_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
# Woo webhook (P2-09). The secret is set on the webhook in the Woo panel; empty = every delivery is rejected.
# The allowed IPs (comma-separated IPs/CIDRs) are empty until the store's addresses are confirmed: empty = IP check off, signature still required.
WOO_WEBHOOK_SECRET=
WOO_WEBHOOK_ALLOWED_IPS=
# Reverse proxies to trust for the client IP (comma-separated IPs/CIDRs); empty trusts none.
TRUSTED_PROXIES=

# RFM's "M" score: 'lifetime' (PRD §12's original NTILE) or 'recent_window' (last METRICS_MONETARY_WINDOW_DAYS
# days only, cut-points from that window's own distribution — P6-20, product-owner decision re: 3-year
# inflation). dev/prod should set recent_window; leave unset (defaults to lifetime) in any environment
# that must keep matching tests/fixtures/expected_metrics.json (GATE 2) byte-for-byte.
METRICS_MONETARY_MODE=recent_window
METRICS_MONETARY_WINDOW_DAYS=60

# AI Analyst (Sprint 7, read-only; PRD §19). Provider is Gemini — project-owner decision, see
# ARCHITECTURE.md/docs/architecture/sprint-7.md (P7-01) — not wired to any code yet (P7-02/P7-03).
GEMINI_API_KEY=
AI_MODEL=
AI_BUDGET_MONTHLY_USD=
AI_BUDGET_WARN_AT=
AI_MAX_CONTEXT_KB=
AI_MAX_TOOL_CALLS_PER_SESSION=
# hm_ai_readonly PostgreSQL role (P7-01, GATE 4) — SELECT-only on 9 named, PII-free tables, no
# write access. Create/update the role with `php artisan hm:ai-setup-readonly` after setting these.
DB_AI_READONLY_HOST=
DB_AI_READONLY_PORT=
DB_AI_READONLY_DATABASE=
DB_AI_READONLY_USERNAME=
DB_AI_READONLY_PASSWORD=
# Admin credential hm:ai-setup-readonly uses to run CREATE ROLE/GRANT/REVOKE for hm_ai_readonly —
# deliberately separate from DB_USERNAME/DB_PASSWORD above (CREATEROLE is a privilege the app's
# everyday runtime credential has no reason to carry permanently). Leave unset to fall back to
# DB_HOST/PORT/DATABASE/USERNAME/PASSWORD (works as long as that user already has CREATEROLE).
DB_AI_ADMIN_HOST=
DB_AI_ADMIN_PORT=
DB_AI_ADMIN_DATABASE=
DB_AI_ADMIN_USERNAME=
DB_AI_ADMIN_PASSWORD=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
